# dependencies
node_modules/
.pnp
.pnp.*

# next.js build output
.next/
out/
next-env.d.ts

# production
build/
dist/

# environment variables — NEVER commit real keys
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# editors / os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Agent skills (npx skills)
# The real skill content lives in .agents/skills/ and IS committed.
# .claude/skills/ holds symlinks pointing at it, generated per machine.
# Symlinks do not survive a clone on Windows without developer mode — they
# arrive as text files containing a path, and the skills silently fail to
# load. So they are regenerated instead: npx skills add Leonxlnx/taste-skill
.claude/skills/
